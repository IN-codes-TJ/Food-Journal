<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="stylesheets/output.css">
    <%-include('partials/favicon') %>
    <title>My Food Journal</title>
</head>
<body>
    <%-include('partials/nav') %>
    <main class="flex flex-col gap-1 justify-center mx-auto max-w-52 w-[80vw]">
        <div class="heading flex flex-col mb-1">
            <%-include('partials/icon', {src:"/assets/food-icon.png", 
            alt:"An icon of a strawberry, linking to the create food page", addClass: "h-4 my-auto p-0"}) %>
            <h2 class="text-center"><%= item['name'] %></h2>
            <%-include('partials/opinionText', {text:item['satisfaction']}) %>
        </div>
        <div class="flex flex-row w-fit gap-1">
            <h3 class="border-underline w-fit">Time Eaten: </h3>
            <p class="align-baseline leading-1 h-fit my-auto border-underline border-b-transparent"><%= item['time'][0].toString().padStart(2, "0") + ':' + item['time'][1].toString().padStart(2, "0") %></p>
        </div>
        <p class="border-style"><%= item['description'] %></p>
        <h3 class="border-underline w-fit">Ingredients</h3>
        <ul>
            <% if (ingredients.length == 0) { %>
                <p>There are no associated ingredients with this food.</p>
            <% } else { %>
                <% for (var ingredient of ingredients) { %>
                    <li class="flex flex-row">
                        <%= ingredient['name'] %>
                        <% if (ingredient['modified'] == true) { %> 
                            <h5 class="text-red-500 mt-0 mb-auto modStar">*</h5>
                            <h5 class="text-red-500 mt-0 mb-auto modification">modification</h5>
                        <% } %>
                    </li>
                <% } %>
            <% } %>
        </ul>

        <h3 class="border-underline w-fit">Effects</h3>
        <ul class="flex flex-col gap-1">
            <% if (effects.length == 0) { %>
                <p>There are no associated effects with this food.</p>
            <% } else { for (var effect of effects) { %>
                <% if (typeof effect['moodid'] != undefined) { %>
                    <li class="div-hover border-light-primary-200 w-fit p-0.5 m-0">
                        <a href="<%= 'mood-item?id='+effect['moodid'] %>" class="flex flex-row gap-1">
                            <%-include('partials/icon', {src:"/assets/mood-icon.png",
                            alt:"An icon of a smiling face, linking to the create mood page", addClass: "h-2 my-auto p-0 still"}) %>
                            <p class="h-fit my-auto"><%= effect['name'] %></p>
                        </a>
                    </li>
                <% } else { %>
                    <li class="div-hover border-light-primary-200 w-fit p-0.5 m-0">
                        <a href="<%= 'sickness-item?id='+effect['sicknessid'] %>" class="flex flex-row gap-1">
                            <%-include('partials/icon', {src:"/assets/sickness-icon.png", 
                            alt:"An icon of an ill face, linking to the create sickness page", addClass: "h-2 my-auto p-0 still"}) %>
                            <p class="h-fit my-auto"><%= effect['name'] %></p>
                        </a>
                    </li>
                <% } %>
            <% }} %>
        </ul>
    </main>
    <script type="module">
        import {modifiedScript} from "./js/modified.js";
        
        const scripts = new modifiedScript();
    </script>
</body>
</html>