<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google-signin-client_id" content="361756584618-r66htrjk50r4l1r9g6cu2760qvub6f3n.apps.googleusercontent.com">
    <script src="https://apis.google.com/js/platform.js" async defer></script>
    <link rel="stylesheet" href="stylesheets/output.css">
    <%-include('partials/favicon') %>
    <title>My Food Journal</title>
</head>
<body>
    <main class="flex flex-col gap-1 justify-center mx-auto max-w-52 w-[80vw]">
        <h1 class="w-fit mx-auto border-underline">Sign-Up (work in progress)</h1>
        <h5 class="text-red-500 text-center">Please Note: By signing up to this website, I will be storing your email address and any other account information you provide. This is used only to identify your data, so you only see the data that belongs to you. </h5>
        <form action="#" method="POST" class="border-style flex flex-col gap-1">
            <fieldset class="flex flex-col">
               <legend for="username" class="px-1 py-0 mb-0">Username</legend>
               <h5 class="px-1">(If no username is entered, it will be set to your email instead)</h5>
               <input name="username" type="username" placeholder="Lorem Ipsum" class="grow div-hover">
               <h5 class="text-red-500 text-center"><%= (typeof usernameErr != "undefined") ? usernameErr : "" %></h5>
            </fieldset>
            <fieldset class="flex flex-col">
               <legend for="email" class="px-1 py-0 mb-0">Email</legend>
               <input name="email" type="email" placeholder="LoremIpsum@gmail.com" class="grow div-hover" required>
               <h5 class="text-red-500 text-center"><%= (typeof emailErr != "undefined") ? emailErr : ""%></h5>
            </fieldset>
            <fieldset class="flex flex-col">
               <label for="password" class="px-1 py-0 mb-0">Password</label>
               <input name="password" type="password" placeholder="*****" class="grow div-hover">
                <% if (typeof passwordErrs != "undefined") { %>
                    <% for (var err of passwordErrs) { %>
                        <h5 class="text-red-500 text-center"><%= err %></h5>
                    <% } %>
                <% } %>
            </fieldset>
            <fieldset class="flex flex-col">
               <label for="confirmPassword" class="px-1 py-0 mb-0">Confirm Password</label>
               <input name="confirmPassword" type="password" placeholder="*****" class="grow div-hover">
               <h5 class="text-red-500 text-center"><%= (typeof confirmPasswordErr != "undefined") ? confirmPasswordErr : "" %></h5>
            </fieldset>

            <input type="submit" value="Sign-Up" name="submit" class="button mx-auto my-0">
            <p class="mx-auto">Already have an account? Login <a href="login" class="hover:text-blue-500 underline">here</a> (or explore alternative methods below).</P>
        </form>
        <h3>Alternative Sign-Up Methods:</h3>
        <a href="/auth/google" class="div-hover w-fit flex flex-row gap-1">
            <img src="assets/google.png" alt="The google icon">
            <p class="my-auto">Sign-up with Google</p>
        </a>
    </main>
</body>