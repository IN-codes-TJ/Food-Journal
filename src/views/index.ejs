<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="stylesheets/output.css">
    <%-include('partials/favicon') %>
    <title>My Food Journal</title>
</head>
<body>
    <%-include('partials/nav', {'home': 'home'}) %>
    <main class="flex flex-col justify-center mx-1">
        <h1 class="text-center">My Food Journal</h1>
        <% if (typeof timeItems[0] != 'undefined') { %>
            <div class="min-w-1/2 mx-auto">
            <% for (var timeItem of timeItems) { %>
                <h2 class="text-center p-0 my-1 mx-auto w-fit border-underline"><%= timeItem['date'] %></h2>
                <% for (var time of timeItem['times']) { %>
                    <h3 class="text-center pb-1"><%= time['time'] %>:00</h3>
                    <% for (var item of time['items']) { %>
                        <a href="<%= item['type'] == 'Food' ? 'food-item?id='+item['id'] : item['type'] == 'Mood' ? 'mood-item?id='+item['id'] : 'sickness-item?id='+item['id']%>"
                        class="flex flex-row gap-1 justify-center div-hover mb-1 w-full">
                            <% if (item['type'] == 'Food') { %>
                                <%-include('partials/icon', {src:"/assets/food-icon.png", 
                                alt:"An icon of a strawberry, linking to the create food page", addClass: "h-2 my-auto p-0"}) %>
                            <% } else if (item['type'] == 'Mood') { %>
                                <%-include('partials/icon', {src:"/assets/mood-icon.png", 
                                alt:"An icon of a smiling face, linking to the create mood page", addClass: "h-2 my-auto p-0"}) %>
                            <% } else { %>
                                <%-include('partials/icon', {src:"/assets/sickness-icon.png", 
                                alt:"An icon of an ill face, linking to the create sickness page", addClass: "h-2 my-auto p-0"}) %>
                            <% } %>
                            <div class="flex flex-col gap-0.5">
                                <h3 class="border-underline"><%= item['name'] %></h3>
                                <p><%= item['description'] %></p>
                            </div>
                            <h3 class="ml-auto mr-0 h-fit border-underline"><%= item['time']['time'][0].toString().padStart(2, "0") + ':' + item['time']['time'][1].toString().padStart(2, "0") %></h3>
                        </a>
                    <% } %>
                <% } %>
            <% } %>
            </div>
        <% } else { %>
            <p>No items</p>
        <% } %>
    </main>
</body>
</html>