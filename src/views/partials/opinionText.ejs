<% if (text == 'Loved') { %>
    <h4 class="border-style border-teal-900 rounded-sm mx-auto w-fit py-0 px-0.5 bg-blue-200 dark:bg-blue-800"><%= text %></h4>
<% } else if (text == 'Liked') { %>
    <h4 class="border-style border-green-900 rounded-sm mx-auto w-fit py-0 px-0.5 bg-green-200 dark:bg-green-800"><%= text %></h4>
<% } else if (text == 'Okay') { %>
    <h4 class="border-style border-yellow-900 rounded-sm mx-auto w-fit py-0 px-0.5 bg-yellow-200 dark:bg-yellow-800"><%= text %></h4>
<% } else if (text == 'Disliked') { %>
    <h4 class="border-style border-orange-900 rounded-sm mx-auto w-fit py-0 px-0.5 bg-orange-200 dark:bg-orange-800"><%= text %></h4>
<% } else if (text == 'Hated') { %>
    <h4 class="border-style border-red-900 rounded-sm mx-auto w-fit py-0 px-0.5 bg-red-200 dark:bg-red-800"><%= text %></h4>
<% } %>